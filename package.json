{
  "name": "dsh-carrot-on-a-stick",
  "version": "0.1.0-rc.1",
  "description": "Operate DeepSeek Harness (dsh) over MCP or from its own sessions: expose dsh sessions, task execution, and workspace management as MCP tools and native dsh tools.",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "src",
    "client",
    "docs",
    "icon.svg",
    "cordis.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p . && tsc -p tsconfig.client.json",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.client.json --noEmit",
    "smoke": "npm run build && node test/smoke.ts && node test/smoke-port.ts",
    "smoke:ui": "npm run build && node test/ui-harness.mjs",
    "test": "npm run smoke",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mcp",
    "model-context-protocol",
    "cordis",
    "ai-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leawind/dsh-carrot-on-a-stick.git"
  },
  "homepage": "https://github.com/Leawind/dsh-carrot-on-a-stick#readme",
  "bugs": {
    "url": "https://github.com/Leawind/dsh-carrot-on-a-stick/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "license": "MIT",
  "author": "Leawind",
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.1-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cosmokit": "~1.8.6",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@types/node": "^26.6.2",
    "typescript": "^5.9.0"
  }
}
